# Flattens objects to fit the generated Parquet schema:
#   - removes cycles that OCSF defines
#   - limits the depth to 3 sub-objects
#   - unmapped becomes JSON

# Cycles in the OCSF spec
if exists(.actor.process.parent_process) {
  .actor.process.parent_process = encode_json(.actor.process.parent_process)
}
if exists(.analytic.related_analytics) {
  .analytic.related_analytics = map_values(array!(.analytic.related_analytics)) -> |e| {
    if is_object(e) { encode_json(e) } else { e }
  }
}
if exists(.assignee.ldap_person.manager) {
  .assignee.ldap_person.manager = encode_json(.assignee.ldap_person.manager)
}
if exists(.dst_endpoint.proxy_endpoint.proxy_endpoint) {
  .dst_endpoint.proxy_endpoint.proxy_endpoint = encode_json(.dst_endpoint.proxy_endpoint.proxy_endpoint)
}
if exists(.evidences) {
  .evidences = map_values(array!(.evidences)) -> |n0_| {
    n0 = object!(n0_)
    if exists(n0.process.parent_process) {
      n0.process.parent_process = encode_json(n0.process.parent_process)
    }
    n0
  }
}
if exists(.finding_info.analytic.related_analytics) {
  .finding_info.analytic.related_analytics = map_values(array!(.finding_info.analytic.related_analytics)) -> |e| {
    if is_object(e) { encode_json(e) } else { e }
  }
}
if exists(.finding_info.related_analytics) {
  .finding_info.related_analytics = map_values(array!(.finding_info.related_analytics)) -> |n1_| {
    n1 = object!(n1_)
    if exists(n1.related_analytics) {
      n1.related_analytics = map_values(array!(n1.related_analytics)) -> |e| {
        if is_object(e) { encode_json(e) } else { e }
      }
    }
    n1
  }
}
if exists(.finding_info_list) {
  .finding_info_list = map_values(array!(.finding_info_list)) -> |n0_| {
    n0 = object!(n0_)
    if exists(n0.analytic.related_analytics) {
      n0.analytic.related_analytics = map_values(array!(n0.analytic.related_analytics)) -> |e| {
        if is_object(e) { encode_json(e) } else { e }
      }
    }
    n0
  }
}
if exists(.finding_info_list) {
  .finding_info_list = map_values(array!(.finding_info_list)) -> |n0_| {
    n0 = object!(n0_)
    if exists(n0.related_analytics) {
      n0.related_analytics = map_values(array!(n0.related_analytics)) -> |n1_| {
        n1 = object!(n1_)
        if exists(n1.related_analytics) {
          n1.related_analytics = map_values(array!(n1.related_analytics)) -> |e| {
            if is_object(e) { encode_json(e) } else { e }
          }
        }
        n1
      }
    }
    n0
  }
}
if exists(.logon_process.parent_process) {
  .logon_process.parent_process = encode_json(.logon_process.parent_process)
}
if exists(.network_observation_point.proxy_endpoint.proxy_endpoint) {
  .network_observation_point.proxy_endpoint.proxy_endpoint = encode_json(.network_observation_point.proxy_endpoint.proxy_endpoint)
}
if exists(.osint) {
  .osint = map_values(array!(.osint)) -> |n0_| {
    n0 = object!(n0_)
    if exists(n0.related_analytics) {
      n0.related_analytics = map_values(array!(n0.related_analytics)) -> |n1_| {
        n1 = object!(n1_)
        if exists(n1.related_analytics) {
          n1.related_analytics = map_values(array!(n1.related_analytics)) -> |e| {
            if is_object(e) { encode_json(e) } else { e }
          }
        }
        n1
      }
    }
    n0
  }
}
if exists(.process.parent_process) {
  .process.parent_process = encode_json(.process.parent_process)
}
if exists(.proxy.proxy_endpoint) {
  .proxy.proxy_endpoint = encode_json(.proxy.proxy_endpoint)
}
if exists(.proxy_endpoint.proxy_endpoint) {
  .proxy_endpoint.proxy_endpoint = encode_json(.proxy_endpoint.proxy_endpoint)
}
if exists(.query_evidence.process.parent_process) {
  .query_evidence.process.parent_process = encode_json(.query_evidence.process.parent_process)
}
if exists(.src_endpoint.proxy_endpoint.proxy_endpoint) {
  .src_endpoint.proxy_endpoint.proxy_endpoint = encode_json(.src_endpoint.proxy_endpoint.proxy_endpoint)
}
if exists(.startup_item.process.parent_process) {
  .startup_item.process.parent_process = encode_json(.startup_item.process.parent_process)
}
if exists(.unmanned_system_operator.ldap_person.manager) {
  .unmanned_system_operator.ldap_person.manager = encode_json(.unmanned_system_operator.ldap_person.manager)
}
if exists(.user.ldap_person.manager) {
  .user.ldap_person.manager = encode_json(.user.ldap_person.manager)
}
if exists(.user_result.ldap_person.manager) {
  .user_result.ldap_person.manager = encode_json(.user_result.ldap_person.manager)
}
if exists(.users) {
  .users = map_values(array!(.users)) -> |n0_| {
    n0 = object!(n0_)
    if exists(n0.ldap_person.manager) {
      n0.ldap_person.manager = encode_json(n0.ldap_person.manager)
    }
    n0
  }
}

# Depth guard: max depth of 3
. = map_values(object!(.)) -> |v1| {
  nodes1 = if is_array(v1) { array!(v1) } else { [v1] }
    out1 = map_values(nodes1) -> |nd1| {
      if is_object(nd1) { map_values(object!(nd1)) -> |v2| {
        nodes2 = if is_array(v2) { array!(v2) } else { [v2] }
      out2 = map_values(nodes2) -> |nd2| {
        if is_object(nd2) { map_values(object!(nd2)) -> |v3| {
          nodes3 = if is_array(v3) { array!(v3) } else { [v3] }
        out3 = map_values(nodes3) -> |nd3| {
          if is_object(nd3) { map_values(object!(nd3)) -> |v4| {
            if is_object(v4) { encode_json(v4) }
          else if is_array(v4) { map_values(array!(v4)) -> |e| { if is_object(e) { encode_json(e) } else { e } } }
          else { v4 }
          } } else { nd3 }
        }
        if is_array(v3) { out3 } else { out3[0] }
        } } else { nd2 }
      }
      if is_array(v2) { out2 } else { out2[0] }
      } } else { nd1 }
    }
    if is_array(v1) { out1 } else { out1[0] }
}

if !is_nullish(.unmapped) && !is_string(.unmapped) {
    .unmapped = encode_json(.unmapped)
}

. = compact(., recursive: true)
